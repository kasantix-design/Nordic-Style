generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                    String    @id @default(uuid())
  created_at            DateTime  @default(now())
  handle                String    @unique
  title                 String
  price                 Int
  currency              String    @default("NOK")
  description           String
  philosophy            String
  construction_title    String
  construction_points   Json
  material_name         String
  material_origin       String
  material_story        String
  images                Json
  variants              Json
  seo_title             String
  seo_description       String
}

model Article {
  id          String   @id @default(uuid())
  created_at  DateTime @default(now())
  slug        String   @unique
  title       String
  subtitle    String
  author      String
  date        DateTime
  hero_image  String
  hero_alt    String
  sections    Json
}
